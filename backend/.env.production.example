# Production environment template — never commit real credentials.
DJANGO_SECRET_KEY=generate-a-long-random-secret
DJANGO_DEBUG=False

# PostgreSQL (current application database backend)
DB_NAME=nexora_isp
DB_USER=nexora
DB_PASSWORD=replace-with-strong-database-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Public application host(s), comma-separated
ALLOWED_HOSTS=your-domain.example.com

# Frontend origin(s), comma-separated
CORS_ALLOWED_ORIGINS=https://your-domain.example.com
CSRF_TRUSTED_ORIGINS=https://your-domain.example.com

# HTTPS / secure browser settings
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# WhatsApp / Meta Cloud API — provide real values only in the deployment secret store.
WHATSAPP_ACCESS_TOKEN=replace-with-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace-with-business-account-id
WHATSAPP_VERIFY_TOKEN=replace-with-webhook-verify-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_API_VERSION=v25.0

# Optional notification throttling overrides
LOGIN_THROTTLE_RATE=5/minute
COPILOT_THROTTLE_RATE=10/minute
